<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <AssemblyName>RobocopyTool</AssemblyName>
    <RootNamespace>MF4CopyStudio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    
    <!-- Exclude backup directories -->
    <EnableDefaultPageItems>true</EnableDefaultPageItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);backup\**\*.xaml;backup\**\*.cs</DefaultItemExcludes>
    
    <!-- Single-file publish settings -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    
    <!-- Version info -->
    <Version>1.0.0</Version>
    <Authors>Liu Pengfei</Authors>
    <Company>Robocopy Tool</Company>
    <Product>Robocopy Tool</Product>
    <Description>A lightweight tool for filtering and copying MF4 files</Description>
    <Copyright>Copyright (c) 2026 Liu Pengfei</Copyright>
    <AssemblyTitle>Robocopy Tool</AssemblyTitle>
    
    <!-- Application Icon -->
    <ApplicationIcon>Assets\RobocopyTool.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Embed LICENSE file as resource -->
  <ItemGroup>
    <EmbeddedResource Include="LICENSE">
      <LogicalName>MF4CopyStudio.LICENSE</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet Packages -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- Add Windows Forms for FolderBrowserDialog -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

</Project>
