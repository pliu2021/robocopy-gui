# Backup directories: SOURCE snapshots are tracked (宁滥勿缺 - keep everything textual),
# binary build artifacts inside them stay excluded.
# Whitelist by EXTENSION (not directory name) so loose files at any depth survive.
backup/**
!backup/**/
!backup/**/.gitignore
!backup/**/*.xaml
!backup/**/*.xaml.cs
!backup/**/*.cs
!backup/**/*.csproj
!backup/**/*.sln
!backup/**/*.cmd
!backup/**/*.bat
!backup/**/*.txt
!backup/**/*.md
!backup/**/*.png
!backup/**/*.ico
backup/*/bin/
backup/*/obj/
backup/*/release/
backup/*/release-candidate/
backup/*/TestData/
backup/*/*.exe
backup/*/*.dll
backup/*/*.pdb
backup/*/*.cache

# Test output
tools/output/
TestData/Destination/
TestData/TestOutput/
TestData/**/Destination/
TestData/**/Output/

# Diagnostics
MF4CopyStudio-Diagnostics/
startup-error.txt
startup-success.txt
verify-ui-error.json
verify-ui-success.json

# OS files
Thumbs.db
.DS_Store
.hermes-tmp.*
.hermes-tmp*/

# Release EXE: built artifact, distributed via GitHub Releases (not git)
release/RobocopyTool.exe
Testoutput/
