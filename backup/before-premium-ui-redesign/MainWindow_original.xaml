<Window x:Class="MF4CopyStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Robocopy Tool" 
        Height="720" Width="1080"
        MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource UIFont}">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Buttons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Top Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Log Panel: Fixed height when expanded -->
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>
        
        <!-- Compact Top Bar (72px) -->
        <Border Grid.Row="0" Padding="16,14" Margin="0,0,0,12"
                BorderBrush="#EAECF0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Robocopy Tool" FontSize="21" FontWeight="SemiBold" 
                               Foreground="#101828" VerticalAlignment="Center"/>
                    <TextBlock Text="MF4 file transfer workspace" FontSize="11.5" 
                               Foreground="#667085" 
                               Margin="10,0,0,1" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- About Button -->
                <Button Grid.Column="1"
                        Width="32" Height="32" MinWidth="32" MinHeight="32" 
                        Padding="0" Margin="0" 
                        HorizontalContentAlignment="Center" 
                        VerticalContentAlignment="Center"
                        ClipToBounds="False"
                        Command="{Binding ShowAboutCommand}" 
                        ToolTip="About"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EAF2FF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#DCE9FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    
                    <Viewbox Width="17" Height="17">
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                              Fill="#101828"/>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>
        
        <!-- Main Content (Two Column Layout) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left: Configuration -->
            <Border Grid.Column="0" CornerRadius="{StaticResource CornerRadius}" 
                    Background="{StaticResource CardBackgroundBrush}" 
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    Padding="{StaticResource CardPadding}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="ConfigurationScrollViewer"
                              Style="{StaticResource ModernLightScrollViewerStyle}">
                    <StackPanel>
                        <!-- Source Directory -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Source Directory" FontSize="13" FontWeight="Medium" 
                                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}"/>
                                <Button Grid.Column="1" Content="Browse" Width="72" Margin="8,0,4,0"
                                        Style="{StaticResource SecondaryButton}"/>
                                
                            </Grid>
                        </StackPanel>
                        
                        <!-- Target Directory -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Target Directory" FontSize="13" FontWeight="Medium" 
                                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}"/>
                                <Button Grid.Column="1" Content="Browse" Width="72" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButton}"/>
                            </Grid>
                        </StackPanel>
                        
                        <!-- Keywords -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Folder Keywords" FontSize="13" FontWeight="Medium" 
                                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding KeywordOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" 
                                                  Style="{StaticResource CapsuleCheckBox}" Margin="0,0,8,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        
                        <!-- Advanced Settings Expander -->
                        <Expander Header="Advanced Settings" Margin="0,0,0,12" 
                                  Foreground="{StaticResource PrimaryTextBrush}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Threads" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="8" GroupName="Threads" IsChecked="{Binding ThreadCount, Converter={StaticResource IntToBoolConverter}, ConverterParameter=8}" 
                                                 Style="{StaticResource CapsuleRadioButton}" Margin="0,0,4,0"/>
                                    <RadioButton Content="16" GroupName="Threads" IsChecked="{Binding ThreadCount, Converter={StaticResource IntToBoolConverter}, ConverterParameter=16}" 
                                                 Style="{StaticResource CapsuleRadioButton}" Margin="4,0,4,0"/>
                                    <RadioButton Content="32" GroupName="Threads" IsChecked="{Binding ThreadCount, Converter={StaticResource IntToBoolConverter}, ConverterParameter=32}" 
                                                 Style="{StaticResource CapsuleRadioButton}" Margin="4,0,0,0"/>
                                </StackPanel>
                                
                                <!-- Automatic Run -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Automatic Run" FontSize="12" FontWeight="Medium" 
                                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                    <CheckBox IsChecked="{Binding IsAutomaticRunEnabled}" 
                                              Style="{StaticResource CapsuleCheckBox}"
                                              Content="Automatically check for new MF4 files 10 minutes after each completed run."
                                              Margin="0,0,0,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Right: Task Summary & Actions -->
            <Border Grid.Column="1" CornerRadius="{StaticResource CornerRadius}" 
                    Background="{StaticResource CardBackgroundBrush}" 
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    Padding="{StaticResource CardPadding}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Task Overview -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Task Overview" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                        
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source Directory" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourceStatusText}" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Target Directory" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DestinationStatusText}" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,8,0,0"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Keywords" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedKeywordsSummary}" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,8,0,0"/>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Automatic Run" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AutomaticRunStatusText}" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,8,0,0"/>
                            
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentStatusText}" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,8,0,0"/>
                            
                            
                        </Grid>
                    </StackPanel>
                    
                    <!-- Scan Results Summary (shown after scan) -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ScanResults}" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8" Margin="0,0,0,6" 
                                        Background="#F7F8FA" BorderBrush="#E7EAF0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FolderName}" FontSize="13" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding RelativePath}" FontSize="11" 
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding FileCount}" FontSize="13" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="files" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button Content="START" Height="{StaticResource PrimaryButtonHeight}" 
                                Command="{Binding StartCopyCommand}" Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding IsStartButtonEnabled}"
                                Padding="16,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ClipToBounds="False">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                            <Path Data="M 3,2 L 13,8 L 3,14 Z" Fill="White" Stretch="Uniform"/>
                                        </Viewbox>
                                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Real-time Log Panel -->
        <!-- Real-time Log Panel -->
        <Border Grid.Row="2" CornerRadius="{StaticResource CornerRadius}" 
                Background="#1A1F2E" BorderBrush="#2D3748" BorderThickness="1"
                MaxHeight="240" MinHeight="44"
                Visibility="{Binding IsLogPanelExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Margin="12" Height="180">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Log Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Activity" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                        <TextBlock Text="{Binding ActivityLog.Count, StringFormat='· {0} entries'}" FontSize="12" 
                                   Foreground="#718096" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Auto-scroll" FontSize="12" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                            <ToggleButton IsChecked="{Binding IsAutoScrollEnabled, Mode=TwoWay}" 
                                          Width="36" Height="20" Margin="6,0,0,0"
                                          Style="{StaticResource ModernToggle}"/>
                        </StackPanel>
                        <Button Content="Clear" Command="{Binding ClearLogsCommand}" 
                                Style="{StaticResource SubtleButton}" Foreground="#A0AEC0" FontSize="12"/>
                        <Button Command="{Binding ToggleLogPanelCommand}" Style="{StaticResource IconButton}" 
                                Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" Margin="4,0,0,0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ClipToBounds="False" ToolTip="Collapse Activity">
                            <Viewbox Width="16" Height="16">
                                <Path Data="M 3,6 L 8,11 L 13,6" Fill="#A0AEC0" Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
                
                <!-- Log Entries -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                              x:Name="LogScrollViewer"
                              Style="{StaticResource ModernDarkScrollViewerStyle}">
                    <ItemsControl ItemsSource="{Binding ActivityLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp}" FontSize="12" 
                                               FontFamily="{StaticResource MonoFont}" Foreground="#718096"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="12" FontWeight="SemiBold" 
                                               FontFamily="{StaticResource MonoFont}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#718096"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="SUCCESS">
                                                        <Setter Property="Foreground" Value="#48BB78"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARNING">
                                                        <Setter Property="Foreground" Value="#ED8936"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="Foreground" Value="#F56565"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="FOUND">
                                                        <Setter Property="Foreground" Value="#4299E1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="COPY">
                                                        <Setter Property="Foreground" Value="#9F7AEA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="13" 
                                               Foreground="#E2E8F0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
