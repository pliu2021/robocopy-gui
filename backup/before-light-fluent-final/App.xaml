<Application x:Class="MF4CopyStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MF4CopyStudio.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI Fluent Design fundamentals (load first so explicit keys can override) -->
                <ui:ThemesDictionary />
                <!-- Load design tokens + legacy brush definitions -->
                <ResourceDictionary Source="Styles/DesignTokens.xaml"/>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <!-- Legacy control templates (referenced by StaticResource in MainWindow) -->
                <ResourceDictionary Source="Styles/Buttons.xaml"/>
                <ResourceDictionary Source="Styles/ScrollBars.xaml"/>
                <ResourceDictionary Source="Styles/ModernScrollBars.xaml"/>
                <!-- WPF-UI control styles loaded LAST so implicit styles win for unthemed controls -->
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
