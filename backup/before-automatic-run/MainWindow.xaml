<Window x:Class="MF4CopyStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Robocopy Tool" 
        Height="720" Width="1080"
        MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource UIFont}">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Buttons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Top Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Log Panel -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Compact Top Bar (58-68px) -->
        <Border Grid.Row="0" Padding="16,12" Margin="0,0,0,12"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Robocopy Tool" FontSize="20" FontWeight="SemiBold" 
                               Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Filter and copy MF4 measurement files" FontSize="12" 
                               Foreground="{StaticResource SecondaryTextBrush}" 
                               Margin="12,0,0,2" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Right Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" 
                               Foreground="{StaticResource SecondaryTextBrush}" 
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    
                    <!-- About Button -->
                    <Button Style="{StaticResource IconButton}" Command="{Binding ShowAboutCommand}" ToolTip="About">
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                              Fill="{StaticResource PrimaryTextBrush}" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content (Two Column Layout) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left: Configuration -->
            <Border Grid.Column="0" CornerRadius="{StaticResource CornerRadius}" 
                    Background="{StaticResource CardBackgroundBrush}" 
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    Padding="{StaticResource CardPadding}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Source Directory -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Source Directory" FontSize="13" FontWeight="Medium" 
                                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}"/>
                                <Button Grid.Column="1" Content="Browse" Width="72" Margin="8,0,4,0"
                                        Style="{StaticResource SecondaryButton}"/>
                                <Button Grid.Column="2" Content="Test" Width="72" 
                                        Style="{StaticResource SecondaryButton}"/>
                            </Grid>
                        </StackPanel>
                        
                        <!-- Target Directory -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Target Directory" FontSize="13" FontWeight="Medium" 
                                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}"/>
                                <Button Grid.Column="1" Content="Browse" Width="72" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButton}"/>
                            </Grid>
                        </StackPanel>
                        
                        <!-- Keywords -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Folder Keywords" FontSize="13" FontWeight="Medium" 
                                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding KeywordOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" 
                                                  Style="{StaticResource CapsuleCheckBox}" Margin="0,0,8,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        
                        <!-- File Extension -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="File Type" FontSize="13" FontWeight="Medium" 
                                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <CheckBox Content=".MF4" IsChecked="True" 
                                      Style="{StaticResource CapsuleCheckBox}" Width="80"/>
                        </StackPanel>
                        
                        <!-- Advanced Settings Expander -->
                        <Expander Header="Advanced Settings" Margin="0,0,0,12" 
                                  Foreground="{StaticResource PrimaryTextBrush}">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock Text="Threads" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="8" GroupName="Threads" IsChecked="{Binding ThreadCount, Converter={StaticResource IntToBoolConverter}, ConverterParameter=8}" 
                                                     Style="{StaticResource CapsuleRadioButton}" Margin="0,0,4,0"/>
                                        <RadioButton Content="16" GroupName="Threads" IsChecked="{Binding ThreadCount, Converter={StaticResource IntToBoolConverter}, ConverterParameter=16}" 
                                                     Style="{StaticResource CapsuleRadioButton}" Margin="4,0,4,0"/>
                                        <RadioButton Content="32" GroupName="Threads" IsChecked="{Binding ThreadCount, Converter={StaticResource IntToBoolConverter}, ConverterParameter=32}" 
                                                     Style="{StaticResource CapsuleRadioButton}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                    <TextBlock Text="Retry Count" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBox}" Width="60" HorizontalAlignment="Left"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                                    <TextBlock Text="Retry Wait (s)" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding RetryWaitSeconds, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBox}" Width="60" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Right: Task Summary & Actions -->
            <Border Grid.Column="1" CornerRadius="{StaticResource CornerRadius}" 
                    Background="{StaticResource CardBackgroundBrush}" 
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    Padding="{StaticResource CardPadding}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Task Overview -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Task Overview" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                        
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source Directory" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Configured" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Target Directory" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Configured" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,8,0,0"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Keywords" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="MT_RE" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,8,0,0"/>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="File Type" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text=".MF4" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Scan Results Summary (shown after scan) -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ScanResults}" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8" Margin="0,0,0,6" 
                                        Background="#F7F8FA" BorderBrush="#E7EAF0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FolderName}" FontSize="13" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding RelativePath}" FontSize="11" 
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding FileCount}" FontSize="13" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="files" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button Content="Scan Files" Height="{StaticResource PrimaryButtonHeight}" 
                                Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                                              Fill="White" Width="16" Height="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Real-time Log Panel -->
        <Border Grid.Row="2" CornerRadius="{StaticResource CornerRadius}" 
                Background="#1A1F2E" BorderBrush="#2D3748" BorderThickness="1"
                Visibility="{Binding IsLogPanelExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Row="0" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Log Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Activity" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                        <TextBlock Text="{Binding LogEntries.Count, StringFormat='· {0} entries'}" FontSize="12" 
                                   Foreground="#718096" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox Content="Auto-scroll" IsChecked="{Binding IsAutoScrollEnabled}" 
                                  Foreground="#A0AEC0" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Clear" Command="{Binding ClearLogsCommand}" 
                                Style="{StaticResource SubtleButton}" Foreground="#A0AEC0" FontSize="12"/>
                        <Button Command="{Binding ToggleLogPanelCommand}" Style="{StaticResource IconButton}" Width="28" Height="28">
                            <Path Data="M19 9l-7 7-7-7" Stroke="#A0AEC0" StrokeThickness="2" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
                
                <!-- Log Entries -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                              x:Name="LogScrollViewer">
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp}" FontSize="12" 
                                               FontFamily="{StaticResource MonoFont}" Foreground="#718096"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="12" FontWeight="SemiBold" 
                                               FontFamily="{StaticResource MonoFont}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#718096"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="SUCCESS">
                                                        <Setter Property="Foreground" Value="#48BB78"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARNING">
                                                        <Setter Property="Foreground" Value="#ED8936"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="Foreground" Value="#F56565"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="FOUND">
                                                        <Setter Property="Foreground" Value="#4299E1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="COPY">
                                                        <Setter Property="Foreground" Value="#9F7AEA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="13" 
                                               Foreground="#E2E8F0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
