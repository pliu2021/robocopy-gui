<Window x:Class="MF4CopyStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MF4 Copy Studio" 
        Height="760" Width="1120"
        MinHeight="680" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA"
        FontFamily="Segoe UI Variable, Segoe UI">
    
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="14" Padding="24" Margin="0,0,0,20"
                Background="White" BorderBrush="#E7EAF0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="MF4 Copy Studio" FontSize="28" FontWeight="SemiBold" Foreground="#16181D"/>
                    <TextBlock Text="Quick filter and copy MF4 measurement files" FontSize="14" 
                               Foreground="#667085" Margin="0,6,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="ThemeSelector" Width="120" SelectionChanged="ThemeSelector_SelectionChanged">
                        <ComboBoxItem Content="Light" IsSelected="True"/>
                        <ComboBoxItem Content="Dark"/>
                        <ComboBoxItem Content="System"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Setup View -->
        <Border Grid.Row="1" CornerRadius="14" Padding="24"
                Background="White" BorderBrush="#E7EAF0" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Configuration" FontSize="20" FontWeight="SemiBold" 
                               Margin="0,0,0,20" Foreground="#16181D"/>
                    
                    <!-- Source Directory -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Source Directory" FontSize="14" FontWeight="Medium" 
                                   Foreground="#475569" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourceDirBox" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Height="42" 
                                     Padding="12,0,0,0" VerticalContentAlignment="Center"
                                     BorderBrush="#E7EAF0" BorderThickness="1"/>
                            <Button Grid.Column="1" Content="Browse" 
                                    Margin="10,0,5,0" Click="BrowseSource_Click"
                                    Style="{StaticResource {x:Type Button}}"/>
                            <Button Grid.Column="2" Content="Test" 
                                    Margin="5,0,0,0" Click="TestSource_Click"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Target Directory -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Target Directory" FontSize="14" FontWeight="Medium" 
                                   Foreground="#475569" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TargetDirBox" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" Height="42"
                                     Padding="12,0,0,0" VerticalContentAlignment="Center"
                                     BorderBrush="#E7EAF0" BorderThickness="1"/>
                            <Button Grid.Column="1" Content="Browse" 
                                    Margin="10,0,0,0" Click="BrowseTarget_Click"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Keywords and Extensions -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Folder Keyword(s)" FontSize="14" FontWeight="Medium" 
                                       Foreground="#475569" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding FolderKeyword, UpdateSourceTrigger=PropertyChanged}" Height="42"
                                     Padding="12,0,0,0" VerticalContentAlignment="Center"
                                     BorderBrush="#E7EAF0" BorderThickness="1"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="File Extension(s)" FontSize="14" FontWeight="Medium" 
                                       Foreground="#475569" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding FileExtension, UpdateSourceTrigger=PropertyChanged}" Height="42"
                                     Padding="12,0,0,0" VerticalContentAlignment="Center"
                                     BorderBrush="#E7EAF0" BorderThickness="1"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Status Message -->
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" 
                               Foreground="#667085" Margin="0,0,0,15"/>
                    
                    <!-- Scan Button -->
                    <Button Content="Scan Files" Height="46" FontSize="16" 
                            Command="{Binding ScanCommand}"
                            Style="{StaticResource {x:Type Button}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
