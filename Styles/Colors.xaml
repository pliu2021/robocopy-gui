<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!-- Colors -->
    <!-- Low-saturation blue (muted steel blue): unified button/accent color -->
    <Color x:Key="PrimaryColor">#5B7BC7</Color>
    <Color x:Key="PrimaryHoverColor">#6B89CE</Color>
    <Color x:Key="PrimaryPressedColor">#4A69B5</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="PageBackground">#F7F8FA</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="CardBorder">#E7EAF0</Color>
    <Color x:Key="PrimaryText">#16181D</Color>
    <Color x:Key="SecondaryText">#667085</Color>
    <Color x:Key="InputBackground">#FFFFFF</Color>
    <Color x:Key="InputBorder">#D0D5DD</Color>
    <Color x:Key="InputFocusBorder">#2563EB</Color>
    
    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackground}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorder}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryText}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackground}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorder}"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource InputFocusBorder}"/>
    
    <!-- Accent Colors (Fluent 2 aliases) -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF2F9"/>
    
    <!-- Surface Colors -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource CardBackground}"/>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F2F5FA"/>
    
    <!-- Font Families -->
    <FontFamily x:Key="UIFont">Segoe UI Variable, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, monospace</FontFamily>
    
    <!-- Sizes -->
    <sys:Double x:Key="WindowWidth">1080</sys:Double>
    <sys:Double x:Key="WindowHeight">720</sys:Double>
    <sys:Double x:Key="MinWindowWidth">820</sys:Double>
        <sys:Double x:Key="MinWindowHeight">520</sys:Double>
        <Thickness x:Key="PageMargin">12</Thickness>
        <Thickness x:Key="CardPadding">12</Thickness>
        <sys:Double x:Key="CardSpacing">10</sys:Double>
        <sys:Double x:Key="ControlSpacing">8</sys:Double>
        <sys:Double x:Key="InputHeight">32</sys:Double>
        <sys:Double x:Key="ButtonHeight">32</sys:Double>
        <sys:Double x:Key="PrimaryButtonHeight">38</sys:Double>
    <CornerRadius x:Key="CornerRadius">10</CornerRadius>
    <CornerRadius x:Key="SmallCornerRadius">7</CornerRadius>
    <sys:Double x:Key="IconSize">16</sys:Double>

</ResourceDictionary>